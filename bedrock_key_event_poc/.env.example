AWS_REGION=us-east-1

# Preferred for newer Bedrock models that do not support on-demand invocation directly.
# Example value: ip-xxxxxxxxxxxxxxxxx
# You can also provide full ARN for the inference profile.
BEDROCK_INFERENCE_PROFILE_ID=

# Optional fallback: direct model invocation target.
# Use this only when the model supports on-demand invocation.
BEDROCK_MODEL_ID=
